#!/bin/bash
# Ordered deploy: pull → sync infra → check migrations → migrate → build SPA → reload → smoke.
#
# Why this exists (caught 2026-05-07): a `feat(ingest)` push landed
# code that read `Album.label` *before* the migration adding that
# column was applied. Gunicorn `--reload` picked up the new code in
# under a second; every visitor to /album/<slug> hit a 500 for ~15
# minutes, sending one admin email per request — 30 emails landed
# in the inbox before anyone noticed. The `tq-health` signature-
# dedup we added the same day doesn't cover this path because
# Django's `AdminEmailHandler` mails directly, not via tq-health.
#
# This wrapper enforces the ordering that the operator can't
# reliably do by hand:
#   1. `git pull --ff-only` so we know what's about to deploy.
#   2. `manage.py migrate --check` → if pending, run `migrate` BEFORE
#      gunicorn touches the new code.
#   3. If `web-react/src/` changed in the pulled commits, run
#      `npm run build`.
#   4. `systemctl reload topquaranta-web` (gracefully swap workers).
#   5. Smoke-test a public route + a hot API endpoint.
#
# Usage:
#   sudo /home/topquaranta/bin/tq-deploy              # full deploy
#   sudo /home/topquaranta/bin/tq-deploy --skip-build # if SPA isn't touched
#   sudo /home/topquaranta/bin/tq-deploy --dry        # show plan, no changes
#
# Exit codes:
#   0 OK
#   1 migration step failed
#   2 SPA build failed
#   3 reload failed
#   4 smoke test failed
#   5 infra sync failed

set -euo pipefail

APP_DIR=/home/topquaranta/app
PY=$APP_DIR/.venv/bin/python
SETTINGS=topquaranta.settings.production
SKIP_BUILD=0
DRY=0

for arg in "$@"; do
    case "$arg" in
        --skip-build) SKIP_BUILD=1 ;;
        --dry) DRY=1 ;;
        *) echo "Unknown flag: $arg"; exit 64 ;;
    esac
done

run() {
    if [ "$DRY" = "1" ]; then
        echo "[DRY] $*"
    else
        "$@"
    fi
}

cd "$APP_DIR"

# Run as the `topquaranta` user — the SSH key for github + the .env
# file + the venv all belong to that account. We sudo for the
# reload at the end. Refuse to run under root or any other user so
# the operator gets a clear error instead of a silent SSH failure.
if [ "$(id -un)" != "topquaranta" ]; then
    echo "Run as the topquaranta user (try: sudo -u topquaranta $0 $*)"
    exit 64
fi

echo "→ Cleaning worktree before pull (idempotent)"
# Why: Claude-driven sessions occasionally land artefacts on the
# server worktree (regenerated migrations, ad-hoc preview scripts,
# black/isort reformat residue) when the Mac doesn't have a working
# venv. Those untracked/modified files blocked `git pull --ff-only`
# and the auto-deploy returned exit 1 with no recovery path. Two
# incidents in 12h on 2026-05-18 (PRs #40 and #41) prompted this
# hardening.
#
# All development happens on the Mac → push → deploy, so discarding
# local state is safe: the only files we MUST preserve are under
# `./data/` (cron output). The `-fd` flag of `git clean` only removes
# untracked files and directories that are NOT in .gitignore — venvs,
# caches and DBs stay untouched. `-e data/` is the extra exclusion for
# the cron output directory, which is not gitignored.
PRE_HEAD=$(git rev-parse HEAD)
run git fetch origin main
run git reset --hard origin/main
run git clean -fd -e data/
POST_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "$PRE_HEAD")

echo
echo "→ Sync infra files (Caddyfile, cron, systemd, logrotate)"
# Detect drift between repo (deploy/*) and installed copies, then install
# changed files with proper validation. Caddyfile validation prevents a
# syntax error from taking the web tier down. Idempotent: no-op when
# nothing changed.
if ! run "$APP_DIR/bin/tq-sync-infra"; then
    echo "  tq-sync-infra failed, aborting deploy"
    exit 5
fi

echo
echo "→ Check pending migrations"
if "$PY" -m django migrate --check --settings=$SETTINGS >/dev/null 2>&1; then
    echo "  ✓ DB schema up to date"
else
    echo "  ! Pending migrations detected — applying BEFORE gunicorn reload"
    if ! run "$PY" manage.py migrate --settings=$SETTINGS; then
        echo "  ✗ migrate failed — aborting deploy"
        exit 1
    fi
    echo "  ✓ Migrations applied"
fi

echo
if [ "$SKIP_BUILD" = "0" ] && [ "$PRE_HEAD" != "$POST_HEAD" ]; then
    if git diff --name-only "$PRE_HEAD" "$POST_HEAD" | grep -q '^web-react/'; then
        echo "→ SPA changed — npm run build"
        if ! (cd web-react && run npm run build); then
            echo "  ✗ build failed — aborting before reload"
            exit 2
        fi
    else
        echo "→ SPA untouched — skip build"
    fi
fi

echo
echo "→ systemctl reload topquaranta-web (via sudo)"
if ! run sudo systemctl reload topquaranta-web; then
    echo "  ✗ reload failed"
    exit 3
fi

echo
echo "→ Smoke test"
sleep 1
if [ "$DRY" = "0" ]; then
    code=$(curl -s -o /dev/null -w "%{http_code}" https://www.topquaranta.cat/)
    if [ "$code" != "200" ]; then
        echo "  ✗ public homepage returned $code (expected 200)"
        exit 4
    fi
    code=$(curl -s -o /dev/null -w "%{http_code}" "https://www.topquaranta.cat/api/v1/top/?territori=PPCC")
    if [ "$code" != "200" ]; then
        echo "  ✗ hot API endpoint returned $code (expected 200)"
        exit 4
    fi
    echo "  ✓ homepage 200, /api/v1/top 200"
fi

echo
echo "✓ Deploy complete (HEAD=${POST_HEAD:0:7})"
