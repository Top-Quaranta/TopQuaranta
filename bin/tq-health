#!/bin/bash
# Health summary of the TopQuaranta pipeline.
#
# Reads /var/log/topquaranta/status/*.status (written by tq-run) and prints
# the status of each expected command. Also peeks at the errors.log for
# recent ERROR-level log records.
#
# Exit code:
#   0  all OK
#   1  at least one command is stale or failed, or there are recent errors

set -u

# --email-on-fail: capture the report and only mail it to admin if
# overall=1 (something stale or failed). Designed for hourly cron
# without spamming when everything is healthy.
EMAIL_ON_FAIL=0
EMAIL_TO="${TQ_HEALTH_EMAIL:-admin@topquaranta.cat}"
for arg in "$@"; do
    case "$arg" in
        --email-on-fail) EMAIL_ON_FAIL=1 ;;
    esac
done

STATUS_DIR=/var/log/topquaranta/status
ERRORS_LOG=/var/log/topquaranta/errors.log
NOW=$(date +%s)

# Capture all output if --email-on-fail so we can mail it later.
if (( EMAIL_ON_FAIL )); then
    REPORT=$(mktemp)
    exec 3>&1 1>"$REPORT"
fi

# Per-command max age in hours before we flag STALE.
# Tune carefully: the cron is hourly for novetats, daily for the rest,
# weekly for official ranking. We add a buffer for human-timed drift.
declare -A MAX_AGE_HOURS=(
    [obtenir_novetats]=2
    [obtenir_senyal]=26
    [actualitzar_score_entrada]=26
    [netejar_caducades]=26
    [calcular_ranking_provisional]=26
    [calcular_ranking]=170     # 7 days + 2h buffer
    [tq-restore-test]=840      # 35 days (monthly + 4d buffer)
    [arxivar_senyal_vell]=2400 # 100 days (quarterly + 8d buffer)
    [analitzar_whisper]=48     # nightly + 1 day buffer
)

overall=0
printf "%-32s  %-12s  %s\n" "COMMAND" "STATUS" "LAST RUN"
printf "%-32s  %-12s  %s\n" "-------" "------" "--------"

for cmd in "${!MAX_AGE_HOURS[@]}"; do
    f="$STATUS_DIR/$cmd.status"
    if [[ ! -f "$f" ]]; then
        printf "%-32s  %-12s  %s\n" "$cmd" "NO_STATUS" "(never run via tq-run)"
        overall=1
        continue
    fi
    status=$(grep '^status=' "$f" | cut -d= -f2)
    last=$(grep '^last_run=' "$f" | cut -d= -f2-)
    last_ts=$(date -d "$last" +%s 2>/dev/null || echo 0)
    age_h=$(( (NOW - last_ts) / 3600 ))
    max_h=${MAX_AGE_HOURS[$cmd]}
    skips=$(grep '^consecutive_skips=' "$f" | cut -d= -f2)
    skips=${skips:-0}

    # Order matters: STALE (last_run too old) is the most informative
    # signal. SKIPPED_BY_LOCK alone is fine — it means a long run is
    # in progress; only when it persists past MAX_AGE_HOURS does it
    # become STALE. Pre-2026-05-01 the bug was that lock-skip was
    # written as status=OK with last_run=now, masking stale state.
    if [[ $age_h -gt $max_h ]]; then
        if [[ "$status" == "SKIPPED_BY_LOCK" ]] && (( skips > 0 )); then
            display="STUCK(${age_h}h, ${skips}skips)"
        else
            display="STALE(${age_h}h)"
        fi
        overall=1
    elif [[ "$status" == "SKIPPED_BY_LOCK" ]]; then
        display="SKIP(${skips})"
    elif [[ "$status" != "OK" ]]; then
        display="FAIL"
        overall=1
    else
        display="OK(${age_h}h)"
    fi
    printf "%-32s  %-12s  %s\n" "$cmd" "$display" "$last"
done

# Recent errors from Django LOGGING (errors_file handler in base.py).
echo
if [[ -f "$ERRORS_LOG" ]]; then
    today=$(date +%Y-%m-%d)
    # grep -c prints "0" and exits 1 when there are no matches; using
    # `|| echo 0` here would *append* another "0" and break `[[ -gt ]]`.
    # Use `|| true` to keep grep's "0" output and neutralise the exit code.
    n=$(grep -c "^\[$today" "$ERRORS_LOG" 2>/dev/null || true)
    n=${n:-0}
    if (( n > 0 )); then
        echo "Django errors today ($today): $n"
        echo "  Last 3:"
        grep "^\[$today" "$ERRORS_LOG" | tail -3 | sed 's/^/    /'
        overall=1
    else
        echo "Django errors today: 0"
    fi
else
    echo "(errors log not present yet: $ERRORS_LOG)"
fi

if (( EMAIL_ON_FAIL )); then
    # Restore stdout so the rest of the script can still print.
    exec 1>&3 3>&-
    if (( overall != 0 )); then
        # Use Django's `mail_admins` (Brevo SMTP) — `mail`/`mailx`
        # binaries aren't installed on the box and we don't want a
        # new system dep just for this. Subject summarises the bad
        # lines so the inbox preview is useful at a glance.
        bad=$(grep -E "STALE|STUCK|FAIL|NO_STATUS" "$REPORT" | head -3 | tr '\n' ' | ')
        cd /home/topquaranta/app
        DJANGO_SETTINGS_MODULE=topquaranta.settings.production \
            /home/topquaranta/app/.venv/bin/python -c "
import sys
import django
django.setup()
from django.core.mail import mail_admins
body = sys.stdin.read()
subject = '[TopQuaranta] Pipeline alert: ' + ${bad@Q}
mail_admins(subject, body)
" < "$REPORT" 2>/dev/null \
            || cat "$REPORT" >&2  # fall back to stderr if mail fails
    fi
    rm -f "$REPORT"
fi

exit $overall
