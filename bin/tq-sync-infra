#!/bin/bash
#
# OWNERSHIP CONTRACT (multi-tenant infra on the shared Hetzner box)
#
# This script is the SOLE OWNER of `/etc/caddy/Caddyfile`. The repo
# file `deploy/Caddyfile` is the source of truth; on every deploy we
# diff and re-install the entire file.
#
# This script MUST NOT read, write, or delete anything under
# `/etc/caddy/conf.d/`. That directory is reserved for per-project
# snippets owned by other repos deployed on the same server (e.g.
# `cercol-api.caddy`). The main Caddyfile loads them via an
# `import /etc/caddy/conf.d/*.caddy` directive — independent
# lifecycle, independent reload triggers.
#
# tq-sync-infra: synchronise infrastructure files from repo to system locations.
#
# Compares each `deploy/*` file against its installed copy under `/etc/`.
# When a file differs, validates it (Caddyfile only, currently), installs
# it with root:root 644, and reloads or daemon-reloads the affected
# service. Idempotent: no-op when nothing has drifted.
#
# Run order (called from tq-deploy right after `git pull`):
#   1. Caddyfile: validate first, install, then `systemctl reload caddy`.
#   2. systemd unit: install, then `systemctl daemon-reload`. The actual
#      `reload topquaranta-web` runs later in tq-deploy's main flow.
#   3. cron.d drop-in: install only. cron picks up changes automatically.
#   4. logrotate.d drop-in: install only. logrotate is invoked daily.
#
# Exit codes:
#   0  OK (whether or not anything changed)
#   1  a source file is missing, or Caddyfile validation failed
#  64  wrong user

set -euo pipefail

APP_DIR=/home/topquaranta/app

if [ "$(id -un)" != "topquaranta" ]; then
    echo "Run as the topquaranta user (try: sudo -u topquaranta $0)" >&2
    exit 64
fi

declare -A FILES=(
    ["$APP_DIR/deploy/Caddyfile"]="/etc/caddy/Caddyfile"
    ["$APP_DIR/deploy/cron.topquaranta"]="/etc/cron.d/topquaranta"
    ["$APP_DIR/deploy/logrotate.topquaranta"]="/etc/logrotate.d/topquaranta"
    ["$APP_DIR/deploy/topquaranta-web.service"]="/etc/systemd/system/topquaranta-web.service"
)

caddy_changed=0
systemd_unit_changed=0
anything_changed=0

for src in "${!FILES[@]}"; do
    dst="${FILES[$src]}"
    if [ ! -f "$src" ]; then
        echo "  ! source missing: $src" >&2
        exit 1
    fi
    if sudo cmp -s "$src" "$dst" 2>/dev/null; then
        continue
    fi
    anything_changed=1
    case "$dst" in
        /etc/caddy/Caddyfile)
            echo "  Caddyfile changed, validating before install"
            if ! sudo caddy validate --config "$src" --adapter caddyfile >/dev/null 2>&1; then
                echo "  Caddyfile validation failed:" >&2
                sudo caddy validate --config "$src" --adapter caddyfile >&2 || true
                exit 1
            fi
            sudo install -o root -g root -m 644 "$src" "$dst"
            caddy_changed=1
            ;;
        /etc/systemd/system/topquaranta-web.service)
            echo "  systemd unit changed, installing"
            sudo install -o root -g root -m 644 "$src" "$dst"
            systemd_unit_changed=1
            ;;
        /etc/cron.d/topquaranta)
            echo "  cron config changed, installing"
            sudo install -o root -g root -m 644 "$src" "$dst"
            ;;
        /etc/logrotate.d/topquaranta)
            echo "  logrotate config changed, installing"
            sudo install -o root -g root -m 644 "$src" "$dst"
            ;;
        *)
            # Qualsevol destinació sense tracte especial: instal·lar i
            # prou. Sense aquesta branca, afegir una entrada a FILES no
            # feia res —el `case` no la casava— i l'script eixia amb 0
            # com si l'haguera instal·lada. Va passar el 2026-08-18 amb
            # l'autoconfig de correu: el desplegament va dir que tot
            # anava bé i el fitxer no hi era, així que Caddy va passar de
            # servir-lo desfasat a no servir-lo.
            #
            # Ara FILES és l'única font de veritat: afegir-hi una línia
            # basta, i les branques de dalt només existeixen per als
            # fitxers que a més necessiten validació o un reload.
            echo "  ${dst} changed, installing"
            sudo install -D -o root -g root -m 644 "$src" "$dst"
            ;;
    esac
done

if [ "$caddy_changed" = 1 ]; then
    echo "  reloading caddy"
    sudo systemctl reload caddy
fi

if [ "$systemd_unit_changed" = 1 ]; then
    echo "  daemon-reloading systemd"
    sudo systemctl daemon-reload
fi

# ── operational scripts (/home/topquaranta/bin/) ────────────────────────
# The `tq-*` ops scripts live in the repo (bin/) but RUN from
# /home/topquaranta/bin/. They used to be copied by hand, so repo fixes
# never reached prod — e.g. tq-recover's self-status report (added 2026-06-07)
# sat unapplied and the watchdog showed a perennial stale `MISSING`. Sync
# them here from the repo (source of truth) on drift, preserving the exec
# bit. No sudo: /home/topquaranta/bin is owned by topquaranta. Idempotent.
OPS_BIN_DIR=/home/topquaranta/bin
for src in "$APP_DIR"/bin/tq-*; do
    [ -f "$src" ] || continue
    dst="$OPS_BIN_DIR/$(basename "$src")"
    if ! cmp -s "$src" "$dst" 2>/dev/null; then
        install -o topquaranta -g topquaranta -m 775 "$src" "$dst"
        echo "  installed ops script $(basename "$src")"
        anything_changed=1
    fi
done

if [ "$anything_changed" = 0 ]; then
    echo "  no infra drift"
fi

# Bootstrap log files for the cron lines that run as `postgres`. The
# parent dir /var/log/topquaranta is owned by topquaranta:topquaranta 755,
# so postgres cannot create new files inside it. The cron `>>` redirect
# therefore fails silently the first time. We touch + chown each
# expected log here so postgres can append on subsequent runs.
# Idempotent: only chown when the current owner is wrong.
POSTGRES_LOGS=(
    /var/log/topquaranta/backup.log
    /var/log/topquaranta/restore-test.log
)
for log in "${POSTGRES_LOGS[@]}"; do
    if ! sudo test -f "$log"; then
        sudo install -o postgres -g postgres -m 644 /dev/null "$log"
        echo "  bootstrapped $log (postgres:postgres 644)"
    elif [ "$(sudo stat -c %U "$log")" != "postgres" ]; then
        sudo chown postgres:postgres "$log"
        echo "  fixed owner on $log (postgres:postgres)"
    fi
done

# Self-hosted cover root (Fase 2). PORTADES_ROOT lives under /var,
# which the topquaranta user cannot create itself, so the
# `descarregar_portades` cron (runs as topquaranta) would otherwise
# fail with EACCES on first write. `install -d` is idempotent: it
# creates the dir + parents with the given owner/mode, no-op if it
# already exists with them. Caddy serves /portades/* from here
# (see deploy/Caddyfile); world-readable (755) so caddy can read.
if ! sudo test -d /var/topquaranta/portades; then
    sudo install -d -o topquaranta -g topquaranta -m 755 /var/topquaranta/portades
    echo "  provisioned /var/topquaranta/portades (topquaranta:topquaranta 755)"
fi
