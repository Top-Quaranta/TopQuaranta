#!/bin/bash
# Run a Django management command and record its status.
#
# Usage:
#   tq-run <manage_command> [args...]
#
# Side effects:
#   - Appends the command's stdout/stderr to the caller's stdout (so existing
#     cron lines with ">> logfile" keep working).
#   - Writes /var/log/topquaranta/status/<tag>.status with last_run / exit_code /
#     status=OK|FAIL / attempts=N / last_output (tail 20). The tag is the
#     command name with any "--provisional" flag appended (so setmanal and
#     provisional ranking don't share a status file).
#   - Exits with the command's exit code (last attempt's exit code).
#
# Retry behaviour (R7): on non-zero exit the wrapper retries up to
# MAX_ATTEMPTS times with a fixed backoff schedule between attempts. This
# absorbs transient upstream failures (Last.fm 502, network blips) without
# waiting for the next cron tick or for tq-recover to step in.
#   - obtenir_novetats: 1 attempt (it runs hourly anyway — no point retrying
#     within the hour and burning the rate limit).
#   - everything else: 3 attempts, sleeping 60s then 300s between them.

set -o pipefail

STATUS_DIR=/var/log/topquaranta/status
APP_DIR=/home/topquaranta/app
DJANGO_SETTINGS_MODULE=topquaranta.settings.production

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
    echo "Usage: tq-run <manage_command> [args...]" >&2
    exit 64
fi
shift

# Derive a status tag. calcular_ranking runs twice (provisional vs official)
# with different cadences, so we want separate status entries.
tag="$cmd"
for a in "$@"; do
    if [[ "$a" == "--provisional" ]]; then tag="${cmd}_provisional"; fi
done

# Per-command retry policy. The default applies to anything not listed.
declare -A MAX_ATTEMPTS=(
    [obtenir_novetats]=1
)
DEFAULT_MAX_ATTEMPTS=3
# Backoff schedule (seconds) — element [i] is the sleep BEFORE attempt i+2.
# 3 attempts → wait 60s after #1 fails, then 300s after #2 fails.
BACKOFF=(60 300 600)

max_attempts=${MAX_ATTEMPTS[$cmd]:-$DEFAULT_MAX_ATTEMPTS}

tmpout=$(mktemp)
trap 'rm -f "$tmpout"' EXIT

attempt=1
rc=0
while true; do
    ts=$(date -Iseconds)
    : > "$tmpout"  # truncate before each attempt so last_output is clean
    cd "$APP_DIR"
    DJANGO_SETTINGS_MODULE="$DJANGO_SETTINGS_MODULE" \
        "$APP_DIR/.venv/bin/python" manage.py "$cmd" "$@" 2>&1 | tee "$tmpout"
    rc=${PIPESTATUS[0]}
    if [[ $rc -eq 0 ]] || (( attempt >= max_attempts )); then
        break
    fi
    sleep_s=${BACKOFF[$((attempt-1))]:-600}
    echo "tq-run: attempt $attempt/$max_attempts of '$cmd' failed (exit $rc); sleeping ${sleep_s}s before retry" >&2
    sleep "$sleep_s"
    attempt=$((attempt+1))
done

# Exit 75 = EX_TEMPFAIL (Unix convention) means "skipped because
# another instance holds the lock". We must NOT update `last_run` in
# that case — otherwise an hourly cron tick that's been hitting the
# lock for days masks a hung previous run by always showing a fresh
# last_run timestamp. See music/locks.py for the design rationale
# (caught 2026-05-01 with `obtenir_novetats` stuck for ~12 days).
status_file="$STATUS_DIR/$tag.status"
tmp_status=$(mktemp)
if [[ $rc -eq 75 ]]; then
    # Preserve previous last_run if any. Read it back, else leave blank
    # (which `tq-health` reads as never-run).
    prev_last_run=""
    prev_skip_count=0
    if [[ -f "$status_file" ]]; then
        prev_last_run=$(grep '^last_run=' "$status_file" | cut -d= -f2-)
        prev_skip_count=$(grep '^consecutive_skips=' "$status_file" | cut -d= -f2 || echo 0)
        prev_skip_count=${prev_skip_count:-0}
    fi
    {
        echo "command=$cmd"
        echo "args=$*"
        echo "last_run=$prev_last_run"
        echo "last_skip=$ts"
        echo "exit_code=$rc"
        echo "attempts=$attempt"
        echo "max_attempts=$max_attempts"
        echo "status=SKIPPED_BY_LOCK"
        echo "consecutive_skips=$((prev_skip_count + 1))"
        echo "last_output<<EOF"
        tail -n 20 "$tmpout"
        echo "EOF"
    } > "$tmp_status"
else
    # Opt-in WORK_DONE protocol (2026-05-07): commands that want to
    # surface "did N units of work" to the watchdog emit a final line
    # `WORK_DONE=<int>` to stdout. Pick the LAST occurrence (so a
    # progress-line that happens to look the same earlier doesn't
    # mask the final summary). Default empty when the command is
    # silent — no auto-alarm; just visibility for operators.
    work_done=$(grep -E '^WORK_DONE=[0-9]+$' "$tmpout" | tail -n1 | cut -d= -f2)
    # Track consecutive zero-work runs. Only meaningful when
    # work_done is present AND equals 0; missing → reset count.
    prev_zero_count=0
    prev_fail_count=0
    if [[ -f "$status_file" ]]; then
        prev_zero_count=$(grep '^consecutive_zero_work=' "$status_file" | cut -d= -f2 || echo 0)
        prev_zero_count=${prev_zero_count:-0}
        # Track consecutive failures so the watchdog can escalate a
        # silenced cron that keeps failing (FASE F of the playlists
        # revival, 2026-05-22). Without this, a `silenced=true` flag
        # on a perpetually-FAILing cron hides the regression forever.
        prev_fail_count=$(grep '^consecutive_failures=' "$status_file" | cut -d= -f2 || echo 0)
        prev_fail_count=${prev_fail_count:-0}
    fi
    if [[ "$work_done" == "0" ]]; then
        zero_count=$((prev_zero_count + 1))
    else
        zero_count=0
    fi
    if [[ $rc -eq 0 ]]; then
        fail_count=0
    else
        fail_count=$((prev_fail_count + 1))
    fi
    {
        echo "command=$cmd"
        echo "args=$*"
        echo "last_run=$ts"
        echo "exit_code=$rc"
        echo "attempts=$attempt"
        echo "max_attempts=$max_attempts"
        if [[ $rc -eq 0 ]]; then echo "status=OK"; else echo "status=FAIL"; fi
        echo "consecutive_skips=0"
        echo "consecutive_failures=$fail_count"
        if [[ -n "$work_done" ]]; then
            echo "work_done=$work_done"
            echo "consecutive_zero_work=$zero_count"
        fi
        echo "last_output<<EOF"
        tail -n 20 "$tmpout"
        echo "EOF"
    } > "$tmp_status"
fi
mv "$tmp_status" "$status_file"

exit "$rc"
