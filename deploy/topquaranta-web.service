[Unit]
Description=TopQuaranta - Public Web (Django)
After=network.target postgresql.service

[Service]
User=topquaranta
Group=topquaranta
WorkingDirectory=/home/topquaranta/app
EnvironmentFile=/home/topquaranta/app/.env
ExecStart=/home/topquaranta/app/.venv/bin/gunicorn topquaranta.wsgi:application --bind 127.0.0.1:8083 --workers 2 --timeout 120 --reload --env DJANGO_SETTINGS_MODULE=topquaranta.settings.web_server
# `--reload` makes gunicorn watch every imported `.py` and
# gracefully restart any worker whose source changed since boot.
# Cost: a few stat() calls per request, negligible at our traffic.
# Benefit: edits to renderer / payload / API code are picked up
# automatically, no manual `systemctl reload` needed between
# iterations. (Silent stale-code bug bit us 2026-04-27 on the social
# renderer — gunicorn workers kept the previous `_feed_portada`
# while the file on disk had already been updated.)
#
# SIGHUP still works as an explicit graceful reload — the deploy
# script + the staff "Deploy" hook both fire it.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=always

[Install]
WantedBy=multi-user.target
