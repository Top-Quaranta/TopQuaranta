#!/bin/bash
# Daily PostgreSQL backup with tiered retention.
#
# Must run as user `postgres` (pg_dump uses peer auth).
#
# Retention (on a 288 MB DB, gzipped ~29 MB each, ~600 MB worst case;
# sizes re-measured 2026-07-05, see docs/audits/2026-07-05-recon-backup-offsite.md):
#   - daily/        full dump, last 7 days
#   - weekly/       full dump, last 4 weeks (Sundays)
#   - monthly/      full dump WITH PII (tq-month-pii-*), last 90 days
#   - monthly-safe/ sanitized dump WITHOUT PII data (tq-month-safe-*),
#                   last 12 months — the long series feeds the offsite
#                   layer's `safe` tag (docs/ops/backup-offsite.md)
#
# PII split (2026-07-05, docs/ops/retention.md §Backups): any dump that
# contains community/user data is retained at most 90 days, local and
# offsite. The 12-month series is a full-schema dump whose PII tables
# have their DATA excluded (catalog, rankings and aliases stay intact;
# the excluded set is guarded by topquaranta/tests/test_backup_offsite.py,
# which fails CI if a new model with a user FK is not covered here).

set -euo pipefail

BACKUP_DIR=/home/topquaranta/backups
STATUS_DIR=/var/log/topquaranta/status
DB=topquaranta
DATE=$(date +%Y%m%d-%H%M%S)
DOW=$(date +%u)   # 1..7, 7=Sunday
DOM=$(date +%d)   # 01..31

# Status file so tq-health monitors the backup (caught 2026-06-07: the
# Postgres backup ran outside the tq-run contract and was monitored by
# nothing). Same key=value format as tq-run / tq-restore-test. The
# status dir is group-writable by `postgres` (sticky), so this works
# despite the backup running as the postgres user.
ts=$(date -Iseconds)
status_file="$STATUS_DIR/tq-backup.status"
mkdir -p "$STATUS_DIR"
write_status() {
    local rc="$1" extra="$2" tmp
    tmp=$(mktemp)
    {
        echo "command=tq-backup"
        echo "args="
        echo "last_run=$ts"
        echo "exit_code=$rc"
        if [[ "$rc" -eq 0 ]]; then echo "status=OK"; else echo "status=FAIL"; fi
        echo "last_output<<EOF"
        echo "$extra"
        echo "EOF"
    } > "$tmp"
    chmod 644 "$tmp"  # tq-health (topquaranta) must read a postgres-written file
    mv "$tmp" "$status_file"
}
# set -e would exit before recording a FAIL; the ERR trap leaves one.
on_error() {
    local rc=$?
    write_status "$rc" "aborted at line $1 (exit $rc)" || true
    exit "$rc"
}
trap 'on_error $LINENO' ERR

mkdir -p "$BACKUP_DIR/daily" "$BACKUP_DIR/weekly" "$BACKUP_DIR/monthly" \
         "$BACKUP_DIR/monthly-safe"

out="$BACKUP_DIR/daily/tq-$DATE.sql.gz"
pg_dump "$DB" | gzip -9 > "$out"
size=$(stat -c %s "$out")

# Copy to weekly on Sundays, to monthly on the 1st
if [[ "$DOW" == "7" ]]; then
    cp "$out" "$BACKUP_DIR/weekly/tq-week-$DATE.sql.gz"
fi
if [[ "$DOM" == "01" ]]; then
    cp "$out" "$BACKUP_DIR/monthly/tq-month-pii-$DATE.sql.gz"
    # Sanitized long-series dump: full schema, but the DATA of every
    # table holding personal data is excluded (empty on restore). The
    # only user FK outside comptes is music_staffauditlog.actor, so
    # excluding these leaves no dangling FK at restore time. Guarded by
    # test_backup_offsite.py::test_pii_exclude_list_covers_user_tables.
    # NB: the custom user model keeps the legacy table name `auth_user`
    # (comptes/models.py Meta.db_table), so `comptes_*` alone would MISS
    # the most sensitive table — caught by the invariant test on first run.
    pg_dump "$DB" \
        --exclude-table-data='comptes_*' \
        --exclude-table-data='auth_user*' \
        --exclude-table-data='music_staffauditlog' \
        --exclude-table-data='music_artistalastfmalias' \
        --exclude-table-data='social_*auth' \
        --exclude-table-data='django_session' \
        --exclude-table-data='axes_*' \
        --exclude-table-data='otp_*' \
        --exclude-table-data='django_admin_log' \
        | gzip -9 > "$BACKUP_DIR/monthly-safe/tq-month-safe-$DATE.sql.gz"
fi

# Retention — delete old files
find "$BACKUP_DIR/daily"   -name "tq-*.sql.gz"      -mtime +7  -delete
find "$BACKUP_DIR/weekly"  -name "tq-week-*.sql.gz" -mtime +30 -delete
# PII monthlies: 90 days (docs/ops/retention.md §Backups, 2026-07-05).
find "$BACKUP_DIR/monthly" -name "tq-month-pii-*.sql.gz" -mtime +90 -delete
# Sanitized long series: 12 months.
find "$BACKUP_DIR/monthly-safe" -name "tq-month-safe-*.sql.gz" -mtime +365 -delete
# LEGACY full monthlies (tq-month-<YYYYMMDD>-*, created before the PII
# split; they DO contain PII). The 90-day policy applies forward only —
# deleting these earlier than their original 365-day window needs
# Miquel's explicit OK, so they keep the old rule until they age out.
# The `tq-month-2*` glob matches the date-first legacy names and never
# the new tq-month-pii-*/tq-month-safe-* files.
find "$BACKUP_DIR/monthly" -name "tq-month-2*.sql.gz" -mtime +365 -delete

write_status 0 "file=$out size_bytes=$size date=$DATE"
echo "backup_ok=1 file=$out size_bytes=$size date=$DATE"
