#!/bin/bash
# Health summary of the TopQuaranta pipeline.
#
# Gathers the raw facts (cron status files + cron-meta.json, disk, web
# smoke, Spotify sub-checks, pending migrations, recent Django errors)
# in shell, then hands them to `analytics/health_report.py` which does
# the classification + presentation: one-line executive summary, an
# Anomalies section, crons grouped by logical area, CEST timestamps,
# and a legend. The Python renderer owns the exit code (`overall`):
#
#   0  all OK
#   1  at least one anomaly (stale/failed cron, disk, web, Spotify,
#      pending migration, or recent errors)
#
# --email-on-fail: only mail the report to admin when overall=1, with
# signature-based dedup so a persistent failure doesn't spam hourly.

set -u

EMAIL_ON_FAIL=0
EMAIL_TO="${TQ_HEALTH_EMAIL:-admin@topquaranta.cat}"
for arg in "$@"; do
    case "$arg" in
        --email-on-fail) EMAIL_ON_FAIL=1 ;;
    esac
done

APP_DIR=/home/topquaranta/app
STATUS_DIR=/var/log/topquaranta/status
ERRORS_LOG=/var/log/topquaranta/errors.log
META_FILE="$APP_DIR/deploy/cron-meta.json"
PY="$APP_DIR/.venv/bin/python"
NOW=$(date +%s)

# tq-health runs from /home/topquaranta/bin/ on prod but is sourced
# from the repo in dev/CI; resolve both the health-scripts dir and the
# renderer module against whichever layout exists.
SP_DIR=""
for cand in "$APP_DIR/scripts/health" "$(dirname "$0")/../scripts/health"; do
    [[ -d "$cand" ]] && { SP_DIR="$cand"; break; }
done
RENDER=""
for cand in "$APP_DIR/analytics/health_report.py" "$(dirname "$0")/../analytics/health_report.py"; do
    [[ -f "$cand" ]] && { RENDER="$cand"; break; }
done
if [[ ! -f "$META_FILE" || -z "$RENDER" ]]; then
    echo "ERROR: cron-meta.json or analytics/health_report.py missing." >&2
    exit 2
fi

# ── Disk ───────────────────────────────────────────────────────────────
DISK_PCT=$(df / --output=pcent | tail -1 | tr -d ' %')
DISK_AVAIL=$(df -h / --output=avail | tail -1 | tr -d ' ')

# ── Web surface smoke ──────────────────────────────────────────────────
# 1) SPA shell via Caddy (TLS + Vite dist), 2) hashed CSS asset,
# 3) JSON API straight to gunicorn so a Caddy misconfig can't mask a
# backend regression.
PUBLIC_BASE="${TQ_HEALTH_WEB_PUBLIC:-https://www.topquaranta.cat}"
BACKEND_BASE="${TQ_HEALTH_WEB_BACKEND:-http://127.0.0.1:8083}"

# The shell + hashed-asset probing lives in scripts/health/spa_assets.sh
# so it is testable without a Django env (this script needs the venv and
# cron-meta.json before it gets anywhere). That file documents why the
# check asserts content-type and not just the status code: `try_files`
# makes a MISSING asset return 200 with the SPA shell, so a status-only
# assert could never fail on a stale dist.
#
# Unlike the Spotify/TLS sub-checks this one is not opt-in, so a missing
# script is itself an anomaly rather than a silent OK.
WEB_SPA_OK=0; WEB_SPA_DETAIL="scripts/health/spa_assets.sh no trobat"
if [[ -n "$SP_DIR" && -x "$SP_DIR/spa_assets.sh" ]]; then
    WEB_SPA_DETAIL=$(TQ_HEALTH_WEB_PUBLIC="$PUBLIC_BASE" "$SP_DIR/spa_assets.sh" 2>&1)
    if [[ $? == 0 ]]; then WEB_SPA_OK=1; else WEB_SPA_OK=0; fi
fi

top_body=$(curl -fsS --max-time 10 "$BACKEND_BASE/api/v1/top/?territori=PPCC" 2>/dev/null || true)
if [[ -z "$top_body" ]]; then
    WEB_TOP_OK=0; WEB_TOP_DETAIL="cap resposta de gunicorn :8083"
elif ! grep -qE '"entries"|"posicio"' <<<"$top_body"; then
    WEB_TOP_OK=0; WEB_TOP_DETAIL="200 però sense entries/posicio"
else
    WEB_TOP_OK=1; WEB_TOP_DETAIL="OK"
fi

stats_body=$(curl -fsS --max-time 10 "$BACKEND_BASE/api/v1/stats/" 2>/dev/null || true)
if [[ -z "$stats_body" ]]; then
    WEB_STATS_OK=0; WEB_STATS_DETAIL="cap resposta"
elif ! grep -q '"cancons_verificades"' <<<"$stats_body"; then
    WEB_STATS_OK=0; WEB_STATS_DETAIL="200 però sense cancons_verificades"
else
    WEB_STATS_OK=1; WEB_STATS_DETAIL="OK"
fi

# ── Spotify integration (Premium weekly-cached + playlist coverage) ────
_sev() { case "$1" in 0) echo OK ;; 1) echo WARN ;; *) echo CRIT ;; esac; }
_msg() { "$PY" -c "
import json, sys
try:
    print(json.loads(sys.stdin.read().splitlines()[-1]).get('message', ''))
except Exception as exc:
    print('(no parsejable) %s' % exc)
" 2>/dev/null; }

PREMIUM_SEV="?"; PREMIUM_MSG="(check no disponible)"; PREMIUM_OK=1
if [[ -n "$SP_DIR" && -x "$SP_DIR/spotify_premium_active.sh" ]]; then
    out=$("$SP_DIR/spotify_premium_active.sh" 2>&1); sc=$?
    PREMIUM_SEV=$(_sev "$sc"); PREMIUM_MSG=$(printf '%s' "$out" | _msg)
    [[ "$sc" == 0 ]] && PREMIUM_OK=1 || PREMIUM_OK=0
fi

COVERAGE_SEV="?"; COVERAGE_MSG="(check no disponible)"; COVERAGE_OK=1
if [[ -n "$SP_DIR" && -x "$SP_DIR/spotify_playlist_coverage.sh" ]]; then
    out=$("$SP_DIR/spotify_playlist_coverage.sh" 2>&1); sc=$?
    COVERAGE_SEV=$(_sev "$sc"); COVERAGE_MSG=$(printf '%s' "$out" | _msg)
    [[ "$sc" == 0 ]] && COVERAGE_OK=1 || COVERAGE_OK=0
fi

IGTOKEN_SEV="?"; IGTOKEN_MSG="(check no disponible)"; IGTOKEN_OK=1
if [[ -n "$SP_DIR" && -x "$SP_DIR/instagram_token.sh" ]]; then
    out=$("$SP_DIR/instagram_token.sh" 2>&1); sc=$?
    IGTOKEN_SEV=$(_sev "$sc"); IGTOKEN_MSG=$(printf '%s' "$out" | _msg)
    [[ "$sc" == 0 ]] && IGTOKEN_OK=1 || IGTOKEN_OK=0
fi

# ── TLS certificate expiry (measured on the wire, never from disk) ─────
# Endpoints + threshold live in ConfiguracioGlobal and ship EMPTY, so
# this is a no-op until the operator opts in. See
# docs/post-mortems/2026-07-26-stalwart-cert-expirat.md.
TLSCERT_SEV="?"; TLSCERT_MSG="(check no disponible)"; TLSCERT_OK=1
if [[ -n "$SP_DIR" && -x "$SP_DIR/tls_certs.sh" ]]; then
    out=$("$SP_DIR/tls_certs.sh" 2>&1); sc=$?
    TLSCERT_SEV=$(_sev "$sc"); TLSCERT_MSG=$(printf '%s' "$out" | _msg)
    [[ "$sc" == 0 ]] && TLSCERT_OK=1 || TLSCERT_OK=0
fi

# ── Pending Django migrations ──────────────────────────────────────────
if (cd "$APP_DIR" && DJANGO_SETTINGS_MODULE=topquaranta.settings.production \
    "$PY" manage.py migrate --check >/dev/null 2>&1); then
    MIGRATIONS_OK=1
else
    MIGRATIONS_OK=0
fi

# ── Recent Django errors (errors_file handler in base.py) ──────────────
ERRORS_COUNT=0; ERRORS_LAST=""
if [[ -f "$ERRORS_LOG" ]]; then
    today=$(date +%Y-%m-%d)
    ERRORS_COUNT=$(grep -c "^\[$today" "$ERRORS_LOG" 2>/dev/null || true)
    ERRORS_COUNT=${ERRORS_COUNT:-0}
    if (( ERRORS_COUNT > 0 )); then
        ERRORS_LAST=$(grep "^\[$today" "$ERRORS_LOG" | tail -3)
    fi
fi

# ── Git working-tree drift ─────────────────────────────────────────────
# Delegated to `bin/tq-git-drift` (kept separate so the classification is
# unit-testable). It flags a dirty tree, or HEAD ahead/divergent, or HEAD
# behind by a CODE commit — but NOT a HEAD that merely lags origin/main by
# deploy-ignored (doc-only) commits, which is expected because deploy.yml
# skips deploys for docs/**, *.md, etc. See the helper's header and the
# git-drift row in docs/ops/runbook.md.
GIT_OK=1; GIT_DETAIL="OK (matches origin/main, clean)"
if [[ -d "$APP_DIR/.git" && -x "$APP_DIR/bin/tq-git-drift" ]]; then
    if GIT_DETAIL=$("$APP_DIR/bin/tq-git-drift" "$APP_DIR" 2>/dev/null); then
        GIT_OK=1
    else
        GIT_OK=0
    fi
fi

# ── Assemble extras JSON (env-var passing avoids shell quoting hell) ───
EXTRAS=$(
    DISK_PCT="$DISK_PCT" DISK_AVAIL="$DISK_AVAIL" \
    WEB_SPA_OK="$WEB_SPA_OK" WEB_SPA_DETAIL="$WEB_SPA_DETAIL" \
    WEB_TOP_OK="$WEB_TOP_OK" WEB_TOP_DETAIL="$WEB_TOP_DETAIL" \
    WEB_STATS_OK="$WEB_STATS_OK" WEB_STATS_DETAIL="$WEB_STATS_DETAIL" \
    PREMIUM_SEV="$PREMIUM_SEV" PREMIUM_MSG="$PREMIUM_MSG" PREMIUM_OK="$PREMIUM_OK" \
    COVERAGE_SEV="$COVERAGE_SEV" COVERAGE_MSG="$COVERAGE_MSG" COVERAGE_OK="$COVERAGE_OK" \
    IGTOKEN_SEV="$IGTOKEN_SEV" IGTOKEN_MSG="$IGTOKEN_MSG" IGTOKEN_OK="$IGTOKEN_OK" \
    TLSCERT_SEV="$TLSCERT_SEV" TLSCERT_MSG="$TLSCERT_MSG" TLSCERT_OK="$TLSCERT_OK" \
    MIGRATIONS_OK="$MIGRATIONS_OK" ERRORS_COUNT="$ERRORS_COUNT" ERRORS_LAST="$ERRORS_LAST" \
    GIT_OK="$GIT_OK" GIT_DETAIL="$GIT_DETAIL" \
    "$PY" -c '
import json, os
def b(k): return os.environ.get(k) == "1"
print(json.dumps({
    "disk": {"used_pct": int(os.environ.get("DISK_PCT") or 0), "avail": os.environ.get("DISK_AVAIL", "")},
    "web": [
        {"label": "Web SPA shell", "ok": b("WEB_SPA_OK"), "detail": os.environ.get("WEB_SPA_DETAIL", "")},
        {"label": "Web /api/v1/top", "ok": b("WEB_TOP_OK"), "detail": os.environ.get("WEB_TOP_DETAIL", "")},
        {"label": "Web /api/v1/stats", "ok": b("WEB_STATS_OK"), "detail": os.environ.get("WEB_STATS_DETAIL", "")},
    ],
    "spotify": {
        "premium": {"severity": os.environ.get("PREMIUM_SEV", ""), "message": os.environ.get("PREMIUM_MSG", ""), "ok": b("PREMIUM_OK")},
        "coverage": {"severity": os.environ.get("COVERAGE_SEV", ""), "message": os.environ.get("COVERAGE_MSG", ""), "ok": b("COVERAGE_OK")},
    },
    "instagram": {
        "token": {"severity": os.environ.get("IGTOKEN_SEV", ""), "message": os.environ.get("IGTOKEN_MSG", ""), "ok": b("IGTOKEN_OK")},
    },
    "tls": {
        "certs": {"severity": os.environ.get("TLSCERT_SEV", ""), "message": os.environ.get("TLSCERT_MSG", ""), "ok": b("TLSCERT_OK")},
    },
    "migrations_ok": b("MIGRATIONS_OK"),
    "errors": {"count": int(os.environ.get("ERRORS_COUNT") or 0),
               "last": [l for l in os.environ.get("ERRORS_LAST", "").split(chr(10)) if l]},
    "git": {"ok": b("GIT_OK"), "detail": os.environ.get("GIT_DETAIL", "")},
}))
'
)

# ── Render + classify (Python owns the exit code) ──────────────────────
REPORT=$("$PY" "$RENDER" --status-dir "$STATUS_DIR" --meta-file "$META_FILE" \
    --extras-json "$EXTRAS" --now "$NOW")
overall=$?

if (( EMAIL_ON_FAIL )); then
    if (( overall != 0 )); then
        # Signature-based dedup: only email when the anomaly SET changes,
        # so a persistent failure doesn't refill the inbox every hour.
        # The signature is computed by the renderer over the STABLE
        # identity of the anomalies — escalating crons by (name, state)
        # plus per-threshold booleans — NOT over the rendered text.
        # Caught 2026-06-07: the previous grep over $REPORT captured the
        # summary timestamp, "fa Xh" ages and the daily error count, so
        # every hourly tick produced a fresh key and re-spammed.
        # `bad` is still derived from the text but used ONLY for the
        # human subject line, never for dedup.
        bad=$(grep -E "STALE|STUCK|FAIL|DRIFT" <<<"$REPORT" | head -3 | tr '\n' ' | ')
        SIG_FILE="$STATUS_DIR/_health.alert_sig"
        current_sig=$("$PY" "$RENDER" --status-dir "$STATUS_DIR" \
            --meta-file "$META_FILE" --extras-json "$EXTRAS" --now "$NOW" \
            --print-signature)
        last_sig=$(cat "$SIG_FILE" 2>/dev/null || echo "")
        if [[ "$current_sig" != "$last_sig" ]]; then
            cd "$APP_DIR"
            DJANGO_SETTINGS_MODULE=topquaranta.settings.production \
                "$PY" -c "
import sys, django
django.setup()
from django.core.mail import mail_admins
body = sys.stdin.read()
mail_admins('[TopQuaranta] Pipeline alert: ' + ${bad@Q}, body)
" <<<"$REPORT" 2>/dev/null \
                && echo "$current_sig" > "$SIG_FILE" \
                || printf '%s\n' "$REPORT" >&2  # fall back to stderr if mail fails
        fi
    else
        # Everything OK — clear the signature so the NEXT failure
        # (whenever it appears) gets a fresh alert.
        rm -f "$STATUS_DIR/_health.alert_sig"
    fi
else
    printf '%s\n' "$REPORT"
fi

exit "$overall"
