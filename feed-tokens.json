{
  "_meta": {
    "project": "TopQuaranta · Feed de novetats",
    "canvas": { "width": 1080, "height": 1350, "note": "Llenç fix per a TOTS els canals. Canals truncats (Mastodon/Bluesky) mostren només 4 slides: portada + primeres han de funcionar soles." },
    "units": "Tots els valors en píxels sobre el llenç 1080×1350, llevat indicació. letterSpacing en px. Coordenades x,y = cantó superior esquerre de la caixa de l'element (mesurades del render real).",
    "coordinate_origin": "top-left"
  },

  "brand_anchors": {
    "ink":        "#0a0a0a",
    "ink_warm":   "#141210",
    "yellow":     "#facc15",
    "green_ppcc": "#427c42",
    "green_deep": "#2f5a2f",
    "green_light":"#7bbf7b",
    "white":      "#ffffff",
    "cream":      "#f3ecdd"
  },

  "territories": {
    "pri": { "name": "Principat",        "short": "Catalunya", "abbr": "CAT", "deep": "#2f5a2f", "accent": "#7bbf7b" },
    "val": { "name": "País Valencià",    "short": "València",  "abbr": "VAL", "deep": "#8a4a1e", "accent": "#e8a44d" },
    "bal": { "name": "Illes Balears",    "short": "Balears",   "abbr": "BAL", "deep": "#1f5a63", "accent": "#5cc0cc" },
    "nor": { "name": "Catalunya Nord",   "short": "Nord",      "abbr": "NOR", "deep": "#7a2730", "accent": "#dd7882" },
    "fra": { "name": "Franja de Ponent", "short": "Franja",    "abbr": "FRA", "deep": "#6e5520", "accent": "#d8b257" },
    "and": { "name": "Andorra",          "short": "Andorra",   "abbr": "AND", "deep": "#2c3f63", "accent": "#7595cf" },
    "alg": { "name": "L'Alguer",         "short": "L'Alguer",  "abbr": "ALG", "deep": "#7a3340", "accent": "#d986a0" }
  },

  "fonts": {
    "anton":      { "family": "Anton",              "weights": [400], "role": "crits curts (NOVETATS, ÀLBUMS/SINGLES, capçaleres, abreviatures, pills)", "note": "una sola gruixa; visualment black" },
    "playfair":   { "family": "Playfair Display",   "weights": [700, 800, 900], "role": "glòria editorial (títols d'àlbum)" },
    "instrument": { "family": "Instrument Serif",   "weights": [400], "style": "italic", "role": "xiuxiueig (dates, peus, territori als singles)" },
    "bricolage":  { "family": "Bricolage Grotesque","weights": [500, 700, 800], "role": "mobiliari (artistes, metadades, indicador de pàgina)" }
  },

  "grain": {
    "technique": "soroll monocrom (feTurbulence fractalNoise baseFrequency 0.85, numOctaves 2, escala de grisos) sobreposat amb mode de fusió. En PIL: generar soroll gaussià gris i fusionar.",
    "layers": {
      "cover":        { "opacity": 0.14, "blend": "soft-light" },
      "album_page":   { "opacity": 0.08, "blend": "overlay" },
      "album_band":   { "opacity": 0.12, "blend": "soft-light", "scope": "només dins la banda de territori" },
      "singles_page": { "opacity": 0.08, "blend": "overlay" }
    }
  },

  "logo": {
    "asset": "assets/logo.svg (wordmark real; MAI re-tipografiat)",
    "aspect_ratio": 4.93,
    "variants": {
      "white": "filtre brightness(0) invert(1) → wordmark 100% blanc (sobre verd/ink)",
      "black": "filtre brightness(0) → wordmark 100% negre (sobre groc)",
      "color": "asset original (play blau + Top vermell + Quaranta groc), només sobre ink"
    },
    "placements": {
      "cover":   { "variant": "white", "height": 48, "x": 422, "y": 88,  "align": "centrat horitzontal", "width_at_h": 237 },
      "album":   { "variant": "white", "height": 42, "x": 80,  "y": 70,  "align": "esquerra", "width_at_h": 207 },
      "singles": { "variant": "white", "height": 42, "x": "dreta (right edge = 1010)", "y": 70, "align": "dreta" }
    }
  },

  "cover_art": {
    "role": "HEROI i SAGRAT — mai retallar per la cara ni tapar amb text pesat. Substituir el placeholder per la portada real de Deezer dins el mateix marc/mida.",
    "album_hero_size": 660,
    "singles_thumb_size": 72,
    "box_shadow_album": "0 24px 60px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(255,255,255,0.07)"
  },

  "fallback": {
    "trigger": "cover == null",
    "rule": "tile quadrat de la mida de la portada amb: fons = territori.deep · inicial (1a lletra del títol) en Anton color = territori.accent, mida = 0.5×tile, centrada · keyline interior 2px territori.accent opacitat 0.4 amb inset 0.06×tile · peu 'TOPQUARANTA' Anton mida 0.04×tile letterSpacing 4 color rgba(255,255,255,0.5) a 0.07×tile del fons",
    "applies_to": ["album_hero (660)", "singles_thumb (72)"]
  },

  "slides": {
    "1_portada": {
      "background": "radial-gradient(130% 80% at 50% 0%, #427c42 0%, #2f5a2f 100%) — interior verd PPCC dalt-centre, exterior verd fosc",
      "padding": { "top": 88, "sides": 80, "bottom": 80 },
      "siblings": "kind=albums → etiqueta 'ÀLBUMS' + 'cada dimarts'; kind=singles → 'SINGLES' + 'cada divendres'. Mateixa paleta; NO canvia color de tipus.",
      "elements": [
        { "id": "logo",     "type": "image", "variant": "white", "h": 48, "x": 422, "y": 88, "align": "center" },
        { "id": "presenta", "text": "aquesta setmana presenta", "font": "instrument", "style": "italic", "size": 48, "color": "#f3ecdd", "y": 166, "align": "center" },
        { "id": "novetats", "text": "NOVETATS", "font": "anton", "size": 116, "lineHeight": 0.9, "color": "#ffffff", "y": 499, "align": "center", "note": "bloc NOVETATS+etiqueta centrat verticalment entre 'presenta' i el peu" },
        { "id": "etiqueta", "text": "ÀLBUMS | SINGLES", "font": "anton", "size": 250, "lineHeight": 0.78, "letterSpacing": 1.25, "color": "#facc15", "y": 638, "align": "center", "textShadow": "0 8px 0 rgba(0,0,0,0.16)" },
        { "id": "star",     "text": "★", "font": "anton", "size": 24, "color": "#facc15", "y": 1139, "align": "center", "note": "amb línies horitzontals rgba(255,255,255,0.34) a banda i banda, gap 18" },
        { "id": "pill_setmana", "text": "SETMANA 39", "font": "anton", "size": 38, "letterSpacing": 2, "color": "#0a0a0a", "bg": "#facc15", "padding": "7px 20px", "y": 1206, "note": "fila centrada amb gap 22" },
        { "id": "cadencia", "text": "cada dimarts | cada divendres", "font": "instrument", "style": "italic", "size": 40, "color": "#ffffff", "y": 1208 }
      ]
    },

    "2_album": {
      "background": "#0a0a0a (ink) + gra overlay 0.08",
      "padding_header": { "top": 70, "sides": 80 },
      "band": { "y": 1112, "x": 0, "width": 1080, "height": 238, "background": "territori.deep", "padding": { "top": 50, "sides": 80, "bottom": 58 }, "grain": "0.12 soft-light dins la banda" },
      "cover": { "size": 660, "x": 210, "y": 282, "note": "centrat horitzontal; centrat vertical entre capçalera i banda" },
      "elements": [
        { "id": "logo", "type": "image", "variant": "white", "h": 42, "x": 80, "y": 70 },
        { "id": "etiqueta_nou", "text": "NOU ÀLBUM", "font": "anton", "size": 24, "letterSpacing": 5, "color": "territori.accent", "y": 73, "x_right": 1000, "align": "right" },
        { "id": "titol", "text": "(títol àlbum)", "font": "playfair", "weight": 800, "size": 76, "lineHeight": 0.98, "color": "#ffffff", "x": 80, "y": 1162, "note": "dins la banda; Playfair = la glòria" },
        { "id": "artista", "text": "(artista)", "font": "bricolage", "weight": 700, "size": 38, "color": "rgba(255,255,255,0.85)", "x": 80, "y": 1246 },
        { "id": "terr_abbr", "text": "(abbr)", "font": "anton", "size": 22, "letterSpacing": 2, "color": "territori.accent", "x_right": 1000, "y": 1228, "align": "right" },
        { "id": "terr_name", "text": "(nom territori)", "font": "bricolage", "weight": 700, "size": 26, "color": "#ffffff", "x_right": 1000, "y": 1261, "align": "right" }
      ]
    },

    "3_singles": {
      "background": "#0a0a0a (ink) + gra overlay 0.08",
      "padding": { "top": 66, "sides": 70, "bottom": 60 },
      "header": [
        { "id": "novetats", "text": "NOVETATS", "font": "anton", "size": 76, "lineHeight": 0.9, "letterSpacing": 0.76, "color": "#ffffff", "x": 70, "y": 43 },
        { "id": "singles", "text": "SINGLES", "font": "anton", "size": 76, "lineHeight": 0.9, "color": "#facc15", "x": 70, "y": 111 },
        { "id": "subtitol", "text": "estrenes de la setmana 39", "font": "instrument", "style": "italic", "size": 34, "color": "rgba(255,255,255,0.62)", "x": 70, "y": 211 },
        { "id": "logo", "type": "image", "variant": "white", "h": 42, "y": 70, "x_right": 1010, "align": "right" }
      ],
      "rows": {
        "container": { "x": 70, "y": 285, "width": 940, "height": 941 },
        "count_max": 10, "row_height": 85, "row_pitch": 95, "gap": 10,
        "row_y_starts": [285, 380, 475, 571, 666, 761, 856, 951, 1046, 1141],
        "row_bg": "rgba(255,255,255,0.035) amb keyline inset 0 0 0 1px rgba(255,255,255,0.06)",
        "cells": {
          "terr_chip":  { "x": 70, "width": 92, "height": "85 (alçada de fila)", "bg": "territori.deep", "abbr": { "font": "anton", "size": 26, "color": "territori.accent", "align": "center" } },
          "thumb":      { "x": 180, "size": 72, "y_offset": "centrat vertical (≈ row_y + 6.5)" },
          "titol":      { "x": 270, "font": "bricolage", "weight": 800, "size": 34, "lineHeight": 1.04, "color": "#ffffff", "ellipsis": true },
          "artista":    { "x": 270, "font": "bricolage", "weight": 500, "size": 24, "color": "rgba(255,255,255,0.66)", "ellipsis": true, "note": "sota el títol" },
          "terr_short": { "x_right": 1010, "padding_right": 22, "font": "instrument", "style": "italic", "size": 26, "color": "rgba(255,255,255,0.5)", "align": "right" }
        }
      },
      "footer": {
        "y": 1251,
        "left": { "text": "topquaranta.cat", "font": "instrument", "style": "italic", "size": 30, "color": "rgba(255,255,255,0.55)", "x": 70 },
        "page_indicator": {
          "align": "right (right edge = 1010)",
          "dots": { "height": 10, "radius": 6, "gap": 9, "active_width": 26, "inactive_width": 10, "active_color": "#facc15", "inactive_color": "rgba(255,255,255,0.25)" },
          "gap_to_label": 16,
          "label": { "text": "01 / 02", "font": "bricolage", "weight": 700, "size": 26, "letterSpacing": 1, "color": "rgba(255,255,255,0.6)", "format": "zero-padded NN / NN" }
        }
      },
      "pagination_rule": "fins a 10 files per slide; el sistema reparteix per evitar slides amb 1-2 files òrfenes (p.ex. 14 → 7+7, no 10+4). Múltiples slides → indicador de pàgina."
    }
  }
}
