#!/bin/bash
# Health summary of the TopQuaranta pipeline.
#
# Reads /var/log/topquaranta/status/*.status (written by tq-run) and prints
# the status of each expected command. Also peeks at the errors.log for
# recent ERROR-level log records.
#
# Exit code:
#   0  all OK
#   1  at least one command is stale or failed, or there are recent errors

set -u

# --email-on-fail: capture the report and only mail it to admin if
# overall=1 (something stale or failed). Designed for hourly cron
# without spamming when everything is healthy.
EMAIL_ON_FAIL=0
EMAIL_TO="${TQ_HEALTH_EMAIL:-admin@topquaranta.cat}"
for arg in "$@"; do
    case "$arg" in
        --email-on-fail) EMAIL_ON_FAIL=1 ;;
    esac
done

STATUS_DIR=/var/log/topquaranta/status
ERRORS_LOG=/var/log/topquaranta/errors.log
NOW=$(date +%s)

# Capture all output if --email-on-fail so we can mail it later.
if (( EMAIL_ON_FAIL )); then
    REPORT=$(mktemp)
    exec 3>&1 1>"$REPORT"
fi

# Per-command max age in hours before we flag STALE.
# Tune carefully: the cron is hourly for novetats, daily for the rest,
# weekly for official ranking. We add a buffer for human-timed drift.
#
# Names must match the management command's name (which `tq-run` uses
# as the status filename). Keep this in sync with deploy/cron.topquaranta.
# Last reviewed 2026-05-01 — the renames from `calcular_ranking*` to
# `calcular_top*` (Sprint M) and the removal of `actualitzar_score_entrada`
# (Sprint A) had not been propagated, so the watchdog was firing on
# stale or never-existent names.
declare -A MAX_AGE_HOURS=(
    [obtenir_novetats]=2
    [obtenir_senyal]=26
    [netejar_caducades]=26
    [calcular_top_provisional]=26
    [calcular_top]=170         # weekly: 7 days + 2 h buffer
    [tq-restore-test]=840      # monthly: 35 days + 4d buffer
    [analitzar_whisper]=48     # nightly: 1 day + buffer
    [actualitzar_playlists_spotify]=26  # daily; silenced (see below)
    # `arxivar_senyal_vell` runs quarterly via cron but the first run
    # post-deploy hasn't happened yet — leaving it out until a status
    # file exists, otherwise it floods the watchdog with NO_STATUS
    # noise. Re-add when we see the first run land.
)

# Crons whose FAIL/STALE we accept temporarily — show red on the
# dashboard but don't trigger watchdog emails. Reason logged so
# whoever next inherits this knows why.
declare -A SILENCED=(
    [actualitzar_playlists_spotify]="Esperant Spotify Premium per re-OAuth"
)

overall=0
printf "%-32s  %-12s  %s\n" "COMMAND" "STATUS" "LAST RUN"
printf "%-32s  %-12s  %s\n" "-------" "------" "--------"

for cmd in "${!MAX_AGE_HOURS[@]}"; do
    f="$STATUS_DIR/$cmd.status"
    if [[ ! -f "$f" ]]; then
        printf "%-32s  %-12s  %s\n" "$cmd" "NO_STATUS" "(never run via tq-run)"
        overall=1
        continue
    fi
    status=$(grep '^status=' "$f" | cut -d= -f2)
    last=$(grep '^last_run=' "$f" | cut -d= -f2-)
    last_ts=$(date -d "$last" +%s 2>/dev/null || echo 0)
    age_h=$(( (NOW - last_ts) / 3600 ))
    max_h=${MAX_AGE_HOURS[$cmd]}
    skips=$(grep '^consecutive_skips=' "$f" | cut -d= -f2)
    skips=${skips:-0}

    # Order matters: STALE (last_run too old) is the most informative
    # signal. SKIPPED_BY_LOCK alone is fine — it means a long run is
    # in progress; only when it persists past MAX_AGE_HOURS does it
    # become STALE. Pre-2026-05-01 the bug was that lock-skip was
    # written as status=OK with last_run=now, masking stale state.
    silenced=${SILENCED[$cmd]:-}
    if [[ $age_h -gt $max_h ]]; then
        if [[ "$status" == "SKIPPED_BY_LOCK" ]] && (( skips > 0 )); then
            display="STUCK(${age_h}h, ${skips}skips)"
        else
            display="STALE(${age_h}h)"
        fi
        if [[ -z "$silenced" ]]; then overall=1; else display="$display [silenced]"; fi
    elif [[ "$status" == "SKIPPED_BY_LOCK" ]]; then
        display="SKIP(${skips})"
    elif [[ "$status" != "OK" ]]; then
        display="FAIL"
        if [[ -z "$silenced" ]]; then overall=1; else display="FAIL [silenced]"; fi
    else
        display="OK(${age_h}h)"
    fi
    printf "%-32s  %-12s  %s\n" "$cmd" "$display" "$last"
done

# ── Disk space ────────────────────────────────────────────────────────
# Hetzner CX22 is 38 GB. Whisper HF cache is 3 GB and backups grow
# ~19 MB/day; without monitoring the box silently fills (we hit 99 %
# 2026-05-04 mid-Python-upgrade, almost bricked the server). Alert
# when free drops below 10 %.
echo
DISK_USE=$(df / --output=pcent | tail -1 | tr -d ' %')
DISK_AVAIL=$(df -h / --output=avail | tail -1 | tr -d ' ')
if [[ "$DISK_USE" -ge 90 ]]; then
    echo "Disk: ${DISK_USE}% used, ${DISK_AVAIL} free  ⚠ ALERT (>90%)"
    overall=1
elif [[ "$DISK_USE" -ge 80 ]]; then
    echo "Disk: ${DISK_USE}% used, ${DISK_AVAIL} free  (warn — clean cache or rotate logs soon)"
else
    echo "Disk: ${DISK_USE}% used, ${DISK_AVAIL} free"
fi

# ── Web surface smoke ─────────────────────────────────────────────────
# Catches "we deployed and the site is broken" within the hour without
# waiting for users to complain. Three layers, ordered so the cheapest
# fail surfaces first:
#   1. SPA index.html via Caddy (public URL): 200 + has the
#      <div id="root"> mount point + has a <link rel="stylesheet">
#      referencing a hashed asset.
#   2. Hashed CSS asset: 200 (catches a broken `npm run build` where
#      Vite emitted index.html with a stale asset reference).
#   3. Backend JSON API via gunicorn directly (skips Caddy): /api/v1/
#      ranking/ returns 200 + body parses + has at least one row
#      (catches a backend regression where the SPA loads but every
#      page is empty).
# The SPA layer goes through Caddy (TLS + DNS + reverse-proxy), the
# API layer hits gunicorn straight so we can isolate which side is
# broken when a regression hits.
echo
PUBLIC_BASE="${TQ_HEALTH_WEB_PUBLIC:-https://www.topquaranta.cat}"
BACKEND_BASE="${TQ_HEALTH_WEB_BACKEND:-http://127.0.0.1:8083}"
WEB_OK=1

# 1. SPA shell via the public URL — this exercises Caddy + TLS + Vite dist.
spa_body=$(curl -fsSk --max-time 10 "$PUBLIC_BASE/" 2>/dev/null || true)
if [[ -z "$spa_body" ]]; then
    echo "Web SPA shell:                           ⚠ no response from $PUBLIC_BASE/"
    WEB_OK=0
elif ! grep -q 'id="root"' <<< "$spa_body"; then
    echo "Web SPA shell:                           ⚠ /  served but no <div id=\"root\"> mount"
    WEB_OK=0
else
    css_path=$(grep -oE '/assets/index-[A-Za-z0-9_-]+\.css' <<< "$spa_body" | head -1)
    if [[ -z "$css_path" ]]; then
        echo "Web SPA shell:                           ⚠ /  served but no hashed CSS link found (broken Vite build?)"
        WEB_OK=0
    else
        # 2. Hashed CSS asset reachable.
        css_status=$(curl -fsSk --max-time 5 -o /dev/null -w "%{http_code}" "$PUBLIC_BASE$css_path" 2>/dev/null || echo "000")
        if [[ "$css_status" == "200" ]]; then
            echo "Web SPA shell:                           OK ($css_path → 200)"
        else
            echo "Web SPA shell:                           ⚠ CSS $css_path → $css_status (stale dist? collectstatic missing?)"
            WEB_OK=0
        fi
    fi
fi

# 3. JSON API content sanity — go to gunicorn directly so a Caddy
# misconfig doesn't mask a backend regression.
top_body=$(curl -fsS --max-time 10 "$BACKEND_BASE/api/v1/top/?territori=PPCC" 2>/dev/null || true)
if [[ -z "$top_body" ]]; then
    echo "Web /api/v1/top/?territori=PPCC:         ⚠ no response from gunicorn :8083"
    WEB_OK=0
elif ! grep -qE '"entries"|"posicio"' <<< "$top_body"; then
    echo "Web /api/v1/top/?territori=PPCC:         ⚠ 200 but body lacks expected keys (entries/posicio)"
    WEB_OK=0
else
    echo "Web /api/v1/top/?territori=PPCC:         OK"
fi

stats_body=$(curl -fsS --max-time 10 "$BACKEND_BASE/api/v1/stats/" 2>/dev/null || true)
if [[ -z "$stats_body" ]]; then
    echo "Web /api/v1/stats/:                      ⚠ no response"
    WEB_OK=0
elif ! grep -q '"cancons_verificades"' <<< "$stats_body"; then
    echo "Web /api/v1/stats/:                      ⚠ 200 but no cancons_verificades key"
    WEB_OK=0
else
    echo "Web /api/v1/stats/:                      OK"
fi

if (( WEB_OK == 0 )); then overall=1; fi

# ── Pending Django migrations (added 2026-05-07 after the
# Album.label deploy ordering bug — caught a 30-email inbox flood
# when code was reloaded before the migration adding the column was
# applied. Surfacing pending migrations in tq-health gives the
# operator at least one cron tick to catch the desync before user
# requests start hitting `column does not exist` 500s).
echo
PY=/home/topquaranta/app/.venv/bin/python
if (cd /home/topquaranta/app && \
    DJANGO_SETTINGS_MODULE=topquaranta.settings.production \
    "$PY" manage.py migrate --check >/dev/null 2>&1); then
    echo "DB migrations:                           OK (schema matches code)"
else
    echo "DB migrations:                           ⚠ pending — run tq-deploy or migrate"
    overall=1
fi

# ── Recent errors from Django LOGGING (errors_file handler in base.py).
echo
if [[ -f "$ERRORS_LOG" ]]; then
    today=$(date +%Y-%m-%d)
    # grep -c prints "0" and exits 1 when there are no matches; using
    # `|| echo 0` here would *append* another "0" and break `[[ -gt ]]`.
    # Use `|| true` to keep grep's "0" output and neutralise the exit code.
    n=$(grep -c "^\[$today" "$ERRORS_LOG" 2>/dev/null || true)
    n=${n:-0}
    if (( n > 0 )); then
        echo "Django errors today ($today): $n"
        echo "  Last 3:"
        grep "^\[$today" "$ERRORS_LOG" | tail -3 | sed 's/^/    /'
        overall=1
    else
        echo "Django errors today: 0"
    fi
else
    echo "(errors log not present yet: $ERRORS_LOG)"
fi

if (( EMAIL_ON_FAIL )); then
    # Restore stdout so the rest of the script can still print.
    exec 1>&3 3>&-
    if (( overall != 0 )); then
        # Signature-based dedup (2026-05-07): without this the cron
        # fires every hour and sends the same alert email each time
        # for as long as a failure persists — the inbox fills up
        # with copies of an alert the operator already saw. Caught
        # when 15 historical MB-cron errors kept counting toward
        # "errors today" for hours after the underlying process was
        # killed and the issue resolved.
        #
        # Hash the failure summary; only email when the hash CHANGES.
        # That means:
        #   - first time something breaks → email fires (state set).
        #   - same broken state next hour → silent (state unchanged).
        #   - new failure appears OR count of errors grows →
        #     hash changes → fresh email.
        #   - everything recovers → next OK run wipes the state file
        #     so the NEXT failure (whenever it happens) emails again.
        bad=$(grep -E "STALE|STUCK|FAIL|NO_STATUS" "$REPORT" | head -3 | tr '\n' ' | ')
        sig_input="$bad|errors=${n:-0}"
        SIG_FILE=/var/log/topquaranta/status/_health.alert_sig
        current_sig=$(printf '%s' "$sig_input" | sha256sum | cut -d' ' -f1)
        last_sig=$(cat "$SIG_FILE" 2>/dev/null || echo "")
        if [[ "$current_sig" != "$last_sig" ]]; then
            cd /home/topquaranta/app
            DJANGO_SETTINGS_MODULE=topquaranta.settings.production \
                /home/topquaranta/app/.venv/bin/python -c "
import sys
import django
django.setup()
from django.core.mail import mail_admins
body = sys.stdin.read()
subject = '[TopQuaranta] Pipeline alert: ' + ${bad@Q}
mail_admins(subject, body)
" < "$REPORT" 2>/dev/null \
                && echo "$current_sig" > "$SIG_FILE" \
                || cat "$REPORT" >&2  # fall back to stderr if mail fails
        fi
    else
        # Everything's OK — clear the signature so the NEXT failure
        # (whenever it appears) gets a fresh alert.
        rm -f /var/log/topquaranta/status/_health.alert_sig
    fi
    rm -f "$REPORT"
fi

exit $overall
