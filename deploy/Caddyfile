{
	# Rebràs avisos d'expiració i errors d'emissió
	email admin@topquaranta.cat
}

# — Apex → WWW (canònic)
topquaranta.cat {
	# envia HSTS també en la redirecció de l'apex
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	redir https://www.topquaranta.cat{uri} 301
}

# — Lloc principal
#
# Routing (Sprint 4 post-flip):
#   /static/*                       → Django staticfiles on disk
#   /api/*, /sitemap.xml, /robots.txt → Django (API + SEO surfaces)
#   /compte/2fa/*, /compte/activar/*,
#   /compte/registre/, /compte/login/, /compte/logout/
#                                   → Django (flows not yet in React)
#   /beta, /beta/*                  → 301 redirect to the matching
#                                     React path (kept for a while so
#                                     in-flight bookmarks don't 404)
#   everything else                 → React SPA `dist/` with an
#                                     index.html fallback so client
#                                     routes resolve
www.topquaranta.cat {
	encode zstd gzip

	# Django staticfiles (admin/OTP assets, legacy template CSS/JS).
	handle_path /static/* {
		root * /home/topquaranta/app/staticfiles
		file_server
	}

	# User-uploaded media (profile photos + publication images).
	handle_path /media/* {
		root * /home/topquaranta/app/media
		file_server
	}

	# Social PNGs that Meta's media-fetcher downloads. Served as
	# pure static files (no Django, no CSP/COOP/Vary headers) — the
	# `instagram_content_publish` fetcher rejected the Django view
	# response with code 9004 ("Only photo or video can be accepted
	# as media type"). The site-level security-headers block below is
	# scoped with `@not_social_media` so CSP / X-Frame-Options never
	# leak onto this path (they did until 2026-06-03 despite this note).
	# Pair with `SOCIAL_PUBLIC_BASE` =
	# "https://www.topquaranta.cat/static/social" in settings.
	handle_path /static/social/* {
		root * /var/cache/topquaranta/social/renders
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Brand assets (BIMI SVG, etc.). Same simple-file-server pattern.
	handle_path /static/brand/* {
		root * /var/www/brand
		file_server
		header Cache-Control "public, max-age=86400"
		header Content-Type "image/svg+xml"
	}

	# Self-hosted covers (Fase 2). PORTADES_ROOT is
	# /var/topquaranta/portades; `root */var/topquaranta` + the
	# `/portades/*` request path resolves to it without a rewrite.
	# Filenames are content-addressed (<deezer_id>-<mida>.<format>) so
	# a generated variant never changes → 1-year `immutable` cache.
	# Images are not in Caddy's default `encode` content-type
	# allowlist, so the host-level `encode zstd gzip` does NOT
	# recompress them. Explicit Content-Type per extension because the
	# global `X-Content-Type-Options: nosniff` makes the browser trust
	# the header verbatim and Go's mime table doesn't always know
	# `.avif`. `file_server` returns a native 404 when the variant
	# hasn't been generated yet (the Fase 3 frontend falls back to the
	# Deezer URL). No `browse`, so no directory listing.
	# See docs/architecture/portades.md.
	@portades path /portades/*
	@portades_avif path /portades/*.avif
	@portades_webp path /portades/*.webp
	@portades_jpg path /portades/*.jpg
	handle @portades {
		root * /var/topquaranta
		header Cache-Control "public, max-age=31536000, immutable"
		header @portades_avif Content-Type "image/avif"
		header @portades_webp Content-Type "image/webp"
		header @portades_jpg Content-Type "image/jpeg"
		file_server
	}

	# Legacy URL pattern from before the React flip (pre-April 2026).
	# Google still has thousands of these URLs in its index and re-crawls
	# them weekly, generating bogus "URL duplicate without canonical" and
	# 404 reports in GSC. Returning 410 Gone signals permanent removal,
	# which Google honours faster than soft 404 (the SPA fallback's
	# current behaviour). Matches the full subtree: /music/artists/...,
	# /music/songs/..., /music/albums/..., /music/artists/?page=N.
	@legacy_music path /music/*
	handle @legacy_music {
		respond "Gone. The /music/... URL pattern was retired in April 2026. See https://www.topquaranta.cat/sitemap.xml for the current catalog." 410
	}

	# ── Django passthrough: only explicit paths still served by the
	# old HTML backend. Everything else falls through to the SPA. ──
	@django {
		path /api/*
		path /sitemap.xml
		path /sitemap-*.xml
		path /robots.txt
		# IndexNow key file. Bing/Yandex verification.
		path /8f4c2e5b3a9d7c1f6e0b8a5d4c2e9f7b.txt
		# Bing Webmaster Tools site verification.
		path /BingSiteAuth.xml
		path /rss/*
		path /og/*
		path /compte/2fa/*
		path /compte/activar/*
		path /compte/nova-clau/*
		path /compte/esborrar/*
		path /compte/registre/
		path /compte/login/
		path /compte/logout/
	}
	handle @django {
		reverse_proxy 127.0.0.1:8083
	}

	# ── SEO / SSR-for-bots ──
	# When the User-Agent is a recognised crawler / link-preview bot,
	# reverse-proxy the public SEO paths to Django so the response
	# carries per-page <title>, meta description, OG / Twitter cards
	# and JSON-LD. Humans with a real browser keep getting the SPA
	# from disk so they don't pay an extra round-trip. Sprint S
	# (2026-05-06) — see docs/architecture/seo.md.
	#
	# UA list includes search engines (Googlebot, Bingbot,
	# DuckDuckBot, YandexBot, Applebot), social link previews
	# (Mastodon-class servers, Bluesky, Slackbot, TelegramBot,
	# WhatsApp, facebookexternalhit, Twitterbot, LinkedInBot,
	# Discordbot) and the AI crawlers we want indexing us
	# (GPTBot, ClaudeBot, PerplexityBot, Bytespider).
	@bot {
		header_regexp User-Agent (?i)(googlebot|google-inspectiontool|google-richresultstest|google-pagerenderer|googleother|adsbot-google|bingbot|bingpreview|duckduckbot|yandexbot|applebot|baiduspider|slurp|mastodon|pleroma|akkoma|misskey|bluesky|slackbot|telegrambot|whatsapp|facebookexternalhit|twitterbot|linkedinbot|discordbot|skypeuripreview|gptbot|claudebot|perplexitybot|bytespider|amazonbot|chatgpt-user|cohere-ai|anthropic-ai|aria/|ia_archiver|petalbot|seznambot|vkshare|w3c_validator|developers\.google\.com)
		path / /top /artistes /mapa /com-funciona /estat-musica-catala /comunitat-musics /artista/* /album/* /canco/* /territori/* /comarca/* /decada/* /genere/* /top/*
	}
	handle @bot {
		reverse_proxy 127.0.0.1:8083
	}

	# Legacy /beta/* preview URLs redirect to the root. 302 so we can
	# drop the rule later without SEO pain.
	redir /beta /
	redir /beta/* /{1} 302

	# React SPA — primary UI. `try_files` + index.html fallback so
	# deep links (/top, /artistes/..., /compte, /staff/...) hit the
	# right client route on first load.
	handle {
		root * /home/topquaranta/app/web-react/dist
		try_files {path} /index.html
		file_server
	}

	# Security headers — applied to every response EXCEPT /static/social/*.
	# Instagram's media fetcher (code 9004 "Only photo or video can be
	# accepted as media type") and Telegram's fetcher reject media
	# responses that carry CSP / X-Frame-Options, so the social-render
	# path must stay header-free (it serves only images to external
	# fetchers — see the handle_path block above, which sets just
	# Cache-Control). Caddy applies a site-level `header` block OUTSIDE
	# the handle_path, so an in-handle `header -Content-Security-Policy …`
	# would be re-added here on the way out; scoping the matcher is the
	# only reliable strip.
	@not_social_media not path /static/social/*
	header @not_social_media {
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# S6 CSP (directives):
		#   default-src 'self'         — everything not listed below must
		#                                come from the same origin.
		#   script-src                 — SPA bundle is same-origin. As of
		#                                2026-05-07 the SPA-redirect
		#                                helper is also external (at
		#                                /spa-redirect.js), so we no
		#                                longer need 'unsafe-inline' for
		#                                scripts. React style={{...}} is
		#                                a DOM `style` attribute, NOT
		#                                governed by style-src; safe.
		#   style-src                  — same-origin CSS + Google Fonts
		#                                stylesheet (imported by
		#                                mm-design). The single inline
		#                                <style> block in dist/index.html
		#                                (critical above-the-fold paint)
		#                                is allowed via SHA-256 hash so
		#                                we can drop 'unsafe-inline' here
		#                                too. **The hash must be
		#                                regenerated whenever
		#                                web-react/index.html changes
		#                                its <style> block** — see
		#                                docs/ops/runbook.md §10.
		#   font-src                   — Google Fonts actual font files.
		#   img-src                    — album art from Deezer CDN +
		#                                arbitrary https; data: for the
		#                                inline brand SVG.
		#   connect-src                — fetch() only to same origin.
		#   frame-ancestors            — redundant with X-Frame-Options
		#                                DENY; sent for modern browsers.
		#   form-action                — forms can only submit to same
		#                                origin.
		#   base-uri                   — prevents <base> tag injection.
		#   object-src 'none'          — no Flash/Java/plugin embeds.
		#   upgrade-insecure-requests  — transparent http→https upgrade.
		# `?` (Caddy's "default-set" prefix) means upstream Django
		# views CAN override this for legitimate cases — currently
		# only the GoAccess HTML report at
		# /api/v1/staff/analytics/goaccess/, which needs `data:` fonts
		# and `'unsafe-eval'` for D3 to render. Every other response
		# inherits the strict baseline below.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-Wu+kU5EkXi0rgxBYNZgraQVbF2AN72hbhCSUJEGoGu8=' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
	}
	# Access log retention. Rotation is by size; a rotated segment is
	# gzipped ~15x, so 10 MiB of log costs ~640 KiB on disk. With
	# roll_keep 5 the window collapsed under crawler load: a ClaudeBot
	# sweep on 2026-07-30 burned a whole segment in 2 h 11, leaving
	# generar_goaccess 1 h 32 min of history to report on. 30 segments
	# cost ~19 MiB gzipped and buy ~34 days at the observed baseline.
	# roll_keep_for caps the tail so a quiet period cannot hoard
	# segments indefinitely. See docs/architecture/analytics-goaccess.md.
	log {
		output file /var/log/caddy/topquaranta_access.log {
			roll_size 10MiB
			roll_keep 30
			roll_keep_for 90d
		}
	}
}

# ── Stalwart Mail Server ──
# Reverse-proxy to Stalwart's HTTP admin (bound to localhost:8080).
# IMAP/SMTP traffic does NOT pass through Caddy — those listeners are
# in Stalwart directly on ports 993/465/25/587.
mail.topquaranta.cat {
	# Mozilla Thunderbird autoconfig "well-known" lookup. Lookup
	# order is: ISPDB → autoconfig.<domain> → <domain>/.well-known/
	# autoconfig/... → MX-derived guess. We publish here AND on
	# the dedicated `autoconfig.<domain>` site below to cover both.
	handle /.well-known/autoconfig/mail/config-v1.1.xml {
		root * /var/www/autoconfig/.well-known/autoconfig/mail
		rewrite * /config-v1.1.xml
		file_server
		header Content-Type "application/xml; charset=utf-8"
	}
	reverse_proxy localhost:8080
}

# Subdomain that Thunderbird probes first (`autoconfig.<domain>/mail/
# config-v1.1.xml`). Caddy will auto-issue a Let's Encrypt cert as
# soon as the A record at CDMON points here. Pair with:
#     A autoconfig → 188.245.60.20
autoconfig.topquaranta.cat {
	root * /var/www/autoconfig
	file_server
	header Content-Type "application/xml; charset=utf-8"
}

# Per-project Caddy snippets owned by other repos installed at
# /etc/caddy/conf.d/. Each project ships and reloads its own
# snippet independently. tq-sync-infra MUST NOT touch this dir.
import /etc/caddy/conf.d/*.caddy
