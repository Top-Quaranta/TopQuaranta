# TopQuaranta cron + Django logs.
#
# Deployed to /etc/logrotate.d/topquaranta. Each log is owned by user
# `topquaranta`. They grow most for novetats.log (hourly cron, ~1 MB
# per run before R7's tq-recover kicks in).
#
# Rotated weekly, kept 8 weeks (~2 months of detail). Compressed gzip.
# `copytruncate` so the running cron (which keeps the FD open via `>>`)
# doesn't lose its file descriptor. `notifempty` skips empty rotations
# (errors.log is usually empty).

/var/log/topquaranta/*.log
{
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su topquaranta topquaranta
    # Disk hygiene: prune social renders older than 60 days
    # (Caddy serves them from /var/cache/topquaranta/social/renders/).
    # Per the May-2026 audit, these accumulate ~80 MB and were never
    # cleaned. Runs once a week alongside the rotation. Step 3 switched
    # the renders from PNG to JPG, so prune both (legacy PNGs linger).
    prerotate
        find /var/cache/topquaranta/social/renders/ \( -name '*.png' -o -name '*.jpg' \) -mtime +60 -delete 2>/dev/null || true
    endscript
}
